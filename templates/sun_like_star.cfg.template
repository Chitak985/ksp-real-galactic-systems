// Config name is the name parameter but all lowercase
@Kopernicus:FOR[RealGalacticSystems]
{
  Body
  {
	  RGS = True
    name = {{body_name}}  // Most common name with every special character replaced with an underscore
    barycenter = False
    finalizeOrbit = False
    randomMainMenuBody = False
    contractWeight = 5
    cacheFile = RealGalacticSystems/Cache/{{body_name}}.bin  // Cache filename uses the internal body name

    Template
    {
      name = Sun
    }
    Properties
    {
      displayName = {{display_name}}  // Most common name
      description = {{description}}  // Make a simple description less than 100 symbols (do not cut off at 100 symbols, make it shorter by removing some facts)
      radius = {{radius_m}}  // Radius in meters
      mass = {{mass_kg}}  // Mass in kg
      rotates = true
      rotationPeriod = {{rotation_period_seconds}}  // Seconds for one full rotation
      tidallyLocked = False
      useTheInName = False
      selectable = True
			ScienceValues
			{
				landedDataValue = 100
				splashedDataValue = 100
				flyingLowDataValue = 100
				flyingHighDataValue = 100
				inSpaceLowDataValue = 20
				inSpaceHighDataValue = 15
				recoveryValue = {{recovery_value}}  // Round up 50 + distance from Sol in light-years
				flyingAltitudeThreshold = {{flying_altitude_threshold}}  // Radius/10000
				spaceAltitudeThreshold = {{space_altitude_threshold}}  // Radius*3
			}
    }
    {{orbit}}
    ScaledVersion
    {
      Light
      {
        luminosity = {{luminosity}}  // Sun luminosity is 1360, may need recalculation
				IVASunColor = {{main_color}}  // Main color
        sunlightColor = {{main_color}}  // Main color
				scaledSunlightColor = {{main_color}}  // Main color
				sunLensFlareColor = {{main_color}}  // Main color
				ambientLightColor = {{ambient_color}}  // Main color / 10
        brightnessCurve
        {
          key = -0.01573471 0.2 0 0
          key = 0.005 0.2 0 0
          key = 0.01 0 0 0
        }
        IntensityCurve
        {
          key =	55534 	1.3	0	-5.714E-11
          key =	7168000000000 	0	0	0
        }
        IVAIntensityCurve
        {
          key =	0 	1.17	0 -5.143E-11
          key = 7168000000000 	0	0	0
        }
        ScaledIntensityCurve
        {
          key =	0 	1.3	0	-3.429E-07
          key =	1194666667 	0	0	0
        }
      }
    }
    HazardousBody
    {
      Item
      {
        ambientTemp = {{temperature_k}}  // Temp in K
        AltitudeCurve
        {
            key = 1.00E+08 1.00
            key = 1.00E+10 0.00
        }
      }
    }
  }
}
